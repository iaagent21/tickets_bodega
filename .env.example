# Credenciales del usuario de la API con permisos para la app etiquetas.
STORE_USER_EMAIL=usuario@ejemplo.com
STORE_USER_PASSWORD=tu_contraseña

# URL base de EscanersGlobal API, sin la barra final.
API_URL=http://localhost:4000

# Identificador de la tienda. Ejemplos: la4ta, surti, der, h79.
TIENDA=la4ta

# Define true para simular la recepción sin reclamar jobs ni imprimir.
DRY_RUN=false

# Define true para reclamar e imprimir cada ticket.
# En false se generan PDFs de vista previa sin confirmar jobs.
AUTO_PRINT=true

# Nombre exacto de la impresora en Windows. Vacío = impresora predeterminada.
PRINTER_NAME=

# Duración del lease del job al reclamarlo (30-900 segundos).
LEASE_SECONDS=120

# Frecuencia de recuperación de pendientes, leases vencidos y fallos.
PENDING_POLL_MS=30000

# Opcional: identificador estable de esta PC. Si se omite, se guarda en tickets/.ticket-client-id.
# TICKET_CLIENT_ID=pc-tickets-surti-01

# Timeout de cada llamada a la API.
API_TIMEOUT_MS=15000
