# URL del proyecto Supabase.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon public de Supabase. También puede ser la service_role si es necesario.
SUPABASE_KEY=tu_clave_de_supabase

# Correo del usuario de la tienda registrado en Supabase.
STORE_USER_EMAIL=usuario@ejemplo.com

# Contraseña del usuario de la tienda registrado en Supabase.
STORE_USER_PASSWORD=tu_contraseña

# URL base de la API, sin la barra final.
API_URL=http://localhost:3000

# Nombre exacto de la tabla de pedidos en Supabase.
PEDIDOS_TABLE=pedidos_la4ta

# Identificador de la tienda que espera la API.
TIENDA=la4ta

# Define true para probar sin generar PDF ni imprimir, o false para operar normalmente.
DRY_RUN=false

# Define true para imprimir automáticamente cada ticket, o false para solo generar el PDF.
AUTO_PRINT=true

# Nombre exacto de la impresora en Windows. Déjalo vacío para usar la impresora predeterminada.
PRINTER_NAME=